rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Espacios: lectura pública; creación por usuarios autenticados; edición/borrado solo admin
    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;

      // Accesorios: lectura pública; crear/editar por editor o admin; eliminar solo admin
      match /accessories/{accId} {
        allow read: if true;
        allow create: if request.auth != null && (request.auth.token.editor == true || request.auth.token.admin == true);
        allow update: if request.auth != null && (request.auth.token.editor == true || request.auth.token.admin == true);
        allow delete: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Logs: creación por usuarios autenticados; lectura restringida a editor/admin
    match /logs/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.token.editor == true || request.auth.token.admin == true);
      allow update, delete: if false;
    }

    // Counters: lectura para autenticados; escritura solo admin
    match /counters/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Fallback: denegar escrituras por defecto; lectura pública para otros documentos si lo deseas
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
